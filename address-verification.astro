---
import BaseLayout from '../layouts/BaseLayout.astro';
import RetentionBar from '../components/RetentionBar.astro';
import TrendsVerification from '../components/TrendsVerification.astro';
import FaqSection from '../components/FaqSection.astro';
import { SITE_URL, SITE_NAME, DIRECTORY_UPDATED } from '../data/siteConfig';

const pageTitle = `안전 접속 가이드: 주제별 공식 접속처와 사칭 사이트 구별법 | ${SITE_NAME}`;
const pageDesc = '스포츠 중계, 가상자산, 다시보기, 지원금 조회, 택배 조회처럼 사칭 사이트가 자주 노리는 주제별 공식 접속처와 대표 사이트 공식 주소 확인 포인트를 정리했습니다.';
const canonicalURL = `${SITE_URL}/address-verification/`;

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': `${SITE_NAME} 홈`, 'item': `${SITE_URL}/` },
        { '@type': 'ListItem', 'position': 2, 'name': '안전 접속 가이드', 'item': canonicalURL }
      ]
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      'url': canonicalURL,
      'name': pageTitle,
      'description': pageDesc,
      'inLanguage': 'ko-KR',
      'dateModified': DIRECTORY_UPDATED,
      'isPartOf': { '@id': `${SITE_URL}/#website` },
      'publisher': { '@id': `${SITE_URL}/#organization` }
    }
  ]
};
---
<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalURL={canonicalURL}
  jsonLd={pageSchema}
>
  <RetentionBar />
  <main class="py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6 space-y-4">
      <nav aria-label="브레드크럼 내비게이션" class="text-xs text-slate-500 flex items-center space-x-2">
        <a href="/" class="hover:text-indigo-600 font-bold">🏠 {SITE_NAME} 홈</a>
        <span>/</span>
        <span class="text-slate-900 font-extrabold">안전 접속 가이드</span>
      </nav>
      <header class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-2xs space-y-2">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">최종 업데이트 {DIRECTORY_UPDATED}</span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
          안전 접속 가이드: 주제별 공식 접속처와 사칭 사이트 구별법
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-4xl">
          {pageDesc}
        </p>
      </header>
    </div>
    <TrendsVerification />
  </main>
  <FaqSection hideFaq={true} />
</BaseLayout>
