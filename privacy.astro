---
import BaseLayout from '../layouts/BaseLayout.astro';
import RetentionBar from '../components/RetentionBar.astro';
import FaqSection from '../components/FaqSection.astro';
import { SITE_URL, SITE_NAME, CONTACT_EMAIL } from '../data/siteConfig';

const pageTitle = `개인정보처리방침 | ${SITE_NAME}`;
const pageDesc = `${SITE_NAME}가 수집하는 정보, 브라우저에 저장되는 정보, 외부 서비스 이용 내역과 문의 방법을 안내합니다.`;
const canonicalURL = `${SITE_URL}/privacy/`;
const EFFECTIVE_DATE = '2026-11-01';

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': `${SITE_NAME} 홈`, 'item': `${SITE_URL}/` },
        { '@type': 'ListItem', 'position': 2, 'name': '개인정보처리방침', 'item': canonicalURL }
      ]
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      'url': canonicalURL,
      'name': pageTitle,
      'description': pageDesc,
      'inLanguage': 'ko-KR',
      'dateModified': EFFECTIVE_DATE,
      'isPartOf': { '@id': `${SITE_URL}/#website` }
    }
  ]
};

const sections = [
  {
    h: '1. 수집하는 개인정보',
    p: [
      `${SITE_NAME}는 회원가입 기능이 없으며, 이름·전화번호 같은 개인정보를 입력받지 않습니다.`,
      '이메일이나 텔레그램으로 문의하는 경우, 답변을 위해 보내 주신 이메일 주소·계정명과 문의 내용만 이용하며 문의 처리 후 1년이 지나면 삭제합니다.',
    ],
  },
  {
    h: '2. 브라우저에 저장되는 정보',
    p: [
      '별표(★)로 저장한 개인 북마크 목록은 이용자 브라우저의 저장소(localStorage)에만 저장되며 서버로 전송되지 않습니다. 브라우저의 사이트 데이터 삭제 기능으로 언제든 지울 수 있습니다.',
      '빠른 재방문을 위해 서비스 워커가 일부 페이지를 브라우저에 임시 저장(캐시)할 수 있습니다. 여기에는 개인정보가 포함되지 않습니다.',
    ],
  },
  {
    h: '3. 외부 서비스',
    p: [
      '사이트는 Cloudflare Pages에서 호스팅됩니다. Cloudflare는 보안과 서비스 제공을 위해 접속 IP 주소 등 기술 정보를 처리할 수 있으며, 자세한 내용은 Cloudflare 개인정보처리방침을 따릅니다.',
      '글꼴(Pretendard)은 jsDelivr CDN에서 불러옵니다. 이 과정에서 CDN이 접속 IP 주소 같은 기술 정보를 처리할 수 있습니다.',
      `현재 ${SITE_NAME}는 별도의 방문자 분석 도구나 광고 추적 쿠키를 사용하지 않습니다. 도입하게 되면 이 방침을 먼저 수정해 알립니다.`,
    ],
  },
  {
    h: '4. 외부 링크',
    p: [
      '디렉터리에 소개한 사이트로 이동하면 해당 사이트의 개인정보처리방침이 적용됩니다. 각 사이트에서 개인정보를 입력하기 전에 해당 방침을 확인하세요.',
    ],
  },
  {
    h: '5. 문의',
    p: [
      `개인정보 관련 문의는 ${CONTACT_EMAIL}로 보내 주세요.`,
    ],
  },
];
---
<BaseLayout title={pageTitle} description={pageDesc} canonicalURL={canonicalURL} jsonLd={pageSchema}>
  <RetentionBar />
  <main class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8 space-y-8">
    <nav aria-label="브레드크럼 내비게이션" class="text-xs text-slate-500 flex items-center space-x-2">
      <a href="/" class="hover:text-indigo-600 font-bold">🏠 {SITE_NAME} 홈</a>
      <span>/</span>
      <span class="text-slate-900 font-extrabold">개인정보처리방침</span>
    </nav>

    <article class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-sm space-y-8">
      <header class="border-b border-slate-200 pb-6 space-y-3">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">시행일 <time datetime={EFFECTIVE_DATE}>{EFFECTIVE_DATE}</time></span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">개인정보처리방침</h1>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{pageDesc}</p>
      </header>
      {sections.map((sec) => (
        <section class="space-y-2">
          <h2 class="text-base sm:text-lg font-extrabold text-slate-900">{sec.h}</h2>
          {sec.p.map((t) => <p class="text-xs sm:text-sm text-slate-700 leading-7">{t}</p>)}
        </section>
      ))}
    </article>
  </main>
  <FaqSection hideFaq={true} />
</BaseLayout>
