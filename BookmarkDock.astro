---
// 로그인 없는 개인 북마크 (브라우저 localStorage에만 저장)
---
<section aria-label="내 북마크" class="bg-indigo-50/90 border-b border-indigo-100 py-3.5 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
    <div class="flex items-center space-x-2 shrink-0">
      <span class="text-base">⭐</span>
      <span class="text-xs sm:text-sm font-extrabold text-indigo-950">내 북마크</span>
      <span class="text-[11px] px-2 py-0.5 bg-indigo-100 text-indigo-700 rounded-full font-bold">로그인 없이 이 브라우저에 저장</span>
    </div>

    <div id="bookmark-dock-list" class="flex flex-wrap items-center gap-1.5 flex-1">
      <!-- Populated dynamically via LocalStorage JS -->
    </div>

    <button type="button" id="btn-reset-bookmarks" class="text-[11px] text-indigo-600 hover:text-indigo-900 font-semibold underline shrink-0 self-end sm:self-center">
      기본 8곳 복원
    </button>
  </div>
</section>
