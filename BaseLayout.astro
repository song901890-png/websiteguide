---
import { FAQ_ITEMS, SITES_DATA } from '../data/sitesData';
import { SITE_URL, SITE_NAME, SITE_NAME_FULL, EDITOR_NAME, CONTACT_EMAIL, TELEGRAM_URL } from '../data/siteConfig';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
  articleSection?: string;
  keywords?: string[];
  noindex?: boolean;
  includeHomeSchemas?: boolean;
  jsonLd?: Record<string, any>;
}

const {
  title = `${SITE_NAME} | 분야별 공식 웹사이트 주소 360곳 모음`,
  description = `검색·공공·금융·OTT·AI 도구 등 12개 분야 360곳 공식 웹사이트의 주소와 운영 주체, 비용·가입 조건을 한눈에 비교할 수 있는 ${SITE_NAME}입니다.`,
  canonicalURL = `${SITE_URL}/`,
  ogType = 'website',
  ogImage = `${SITE_URL}/og-image.png`,
  ogImageAlt,
  publishedTime,
  modifiedTime,
  articleSection,
  keywords = [],
  noindex = false,
  includeHomeSchemas = false,
  jsonLd
} = Astro.props;

const cleanPath = new URL(canonicalURL, SITE_URL).pathname.replace(/\/+$/, '');
const pathDepth = cleanPath ? cleanPath.split('/').filter(Boolean).length : 0;
const autoRootPrefix = pathDepth === 0 ? '.' : Array(pathDepth).fill('..').join('/');

const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';

const baseGraph: Record<string, any>[] = [
  {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    'name': SITE_NAME_FULL,
    'url': `${SITE_URL}/`,
    'logo': {
      '@type': 'ImageObject',
      'url': `${SITE_URL}/icon-512.png`,
      'width': 512,
      'height': 512
    },
    'email': CONTACT_EMAIL,
    'sameAs': [TELEGRAM_URL],
    'contactPoint': {
      '@type': 'ContactPoint',
      'email': CONTACT_EMAIL,
      'contactType': 'customer support',
      'availableLanguage': ['Korean']
    }
  },
  {
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    'url': `${SITE_URL}/`,
    'name': SITE_NAME,
    'alternateName': 'WebsiteGuide',
    'description': '12개 분야 360곳 공식 웹사이트의 주소와 이용 조건을 정리한 웹사이트 안내 가이드',
    'inLanguage': 'ko-KR',
    'publisher': { '@id': `${SITE_URL}/#organization` }
  }
];

if (includeHomeSchemas) {
  baseGraph.push(
    {
      '@type': 'ItemList',
      '@id': `${SITE_URL}/#itemlist`,
      'name': '분야별 공식 웹사이트 디렉터리 (12개 분야 360곳)',
      'numberOfItems': SITES_DATA.length,
      'itemListElement': SITES_DATA.map((site, idx) => ({
        '@type': 'ListItem',
        'position': idx + 1,
        'name': site.name,
        'url': site.url
      }))
    },
    {
      '@type': 'FAQPage',
      '@id': `${SITE_URL}/#faq`,
      'mainEntity': FAQ_ITEMS.map((item) => ({
        '@type': 'Question',
        'name': item.question,
        'acceptedAnswer': { '@type': 'Answer', 'text': item.answer }
      }))
    }
  );
}

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': baseGraph
};
const fontHref = 'https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css';
---
<!DOCTYPE html>
<html lang="ko" class="scroll-smooth" data-root-prefix={autoRootPrefix}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={EDITOR_NAME} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content={robotsContent} />
  <meta name="format-detection" content="telephone=no" />

  <!-- Favicon & App Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
  <link rel="apple-touch-icon" sizes="192x192" href="/icon-192.png" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} 블로그 RSS`} href="/rss.xml" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt || title} />

  {ogType === 'article' && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )}
  {ogType === 'article' && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime} />
  )}
  {ogType === 'article' && articleSection && (
    <meta property="article:section" content={articleSection} />
  )}
  {ogType === 'article' && keywords.map((kw) => (
    <meta property="article:tag" content={kw} />
  ))}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- PWA -->
  <meta name="theme-color" content="#0f172a" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

  <!-- Pretendard Variable Font (렌더링 비차단 로딩: 시스템 폰트로 먼저 그린 뒤 교체) -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="preload" as="style" href={fontHref} />
  <link rel="stylesheet" href={fontHref} media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href={fontHref} /></noscript>

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
  <script is:inline>
    (function () {
      /**
       * 로컬 파일(file://)로 dist HTML을 직접 열었을 때 '/blog/' 같은 루트 경로가
       * 드라이브 루트로 연결되는 문제를 막기 위한 경로 보정입니다.
       * 웹 서버(Cloudflare Pages, localhost)에서는 아무 것도 바꾸지 않습니다.
       */
      function resolveSiteHref(rawHref) {
        if (!rawHref || typeof rawHref !== 'string') return rawHref;
        const trimmed = rawHref.trim();
        if (!trimmed.startsWith('/') || trimmed.startsWith('//')) return trimmed;
        if (window.location.protocol !== 'file:') return trimmed;

        let pathPart = trimmed;
        let suffix = '';
        const cut = pathPart.search(/[?#]/);
        if (cut !== -1) {
          suffix = pathPart.slice(cut);
          pathPart = pathPart.slice(0, cut);
        }
        const rootPrefix = document.documentElement.getAttribute('data-root-prefix') || '.';
        if (pathPart === '/' || pathPart === '') return rootPrefix + '/index.html' + suffix;
        if (/\.(xml|json|png|svg|txt|html|ico|webmanifest)$/i.test(pathPart)) return rootPrefix + pathPart + suffix;
        return rootPrefix + pathPart.replace(/\/+$/, '') + '/index.html' + suffix;
      }

      function rewriteLinksForFileProtocol() {
        if (window.location.protocol !== 'file:') return;
        document.querySelectorAll('a[href^="/"]').forEach((a) => {
          a.setAttribute('href', resolveSiteHref(a.getAttribute('href')));
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', rewriteLinksForFileProtocol);
      } else {
        rewriteLinksForFileProtocol();
      }
    })();
  </script>
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased selection:bg-indigo-600 selection:text-white pb-16 sm:pb-0">
  <slot />

  <!-- Global Toast Notification -->
  <div id="toast-notification" role="status" aria-live="polite" class="fixed bottom-16 sm:bottom-5 right-5 z-50 hidden bg-slate-900 text-white px-4 py-3 rounded-xl shadow-xl border border-slate-700 text-xs font-semibold items-center space-x-2">
    <span id="toast-icon">✅</span>
    <span id="toast-message">알림 메시지</span>
  </div>

  <script is:inline define:vars={{ siteUrl: SITE_URL, telegramUrl: TELEGRAM_URL }}>
    (function () {
      let deferredPwaPrompt = null;

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPwaPrompt = e;
      });

      function showToast(msg, icon = '✅') {
        const toast = document.getElementById('toast-notification');
        const msgEl = document.getElementById('toast-message');
        const iconEl = document.getElementById('toast-icon');
        if (!toast || !msgEl || !iconEl) return;
        iconEl.textContent = icon;
        msgEl.textContent = msg;
        toast.classList.remove('hidden');
        toast.classList.add('flex');
        clearTimeout(window.__siteToastTimer);
        window.__siteToastTimer = setTimeout(() => {
          toast.classList.add('hidden');
          toast.classList.remove('flex');
        }, 3200);
      }

      window.showJusoToast = showToast;

      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.pwa-install-trigger').forEach((btn) => {
          btn.addEventListener('click', async () => {
            if (deferredPwaPrompt) {
              deferredPwaPrompt.prompt();
              await deferredPwaPrompt.userChoice;
              deferredPwaPrompt = null;
            } else if (/iPhone|iPad|iPod/i.test(navigator.userAgent)) {
              showToast('iOS Safari: 하단 [공유(↑)] 버튼 → [홈 화면에 추가]를 선택하세요.', '🍎');
            } else {
              showToast('브라우저 메뉴(⋮) → [홈 화면에 추가 / 앱 설치] 또는 Ctrl+D로 북마크하세요.', '📱');
            }
          });
        });

        document.querySelectorAll('.permalink-trigger').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const permalink = siteUrl + '/';
            try {
              await navigator.clipboard.writeText(permalink);
              showToast('사이트 주소(' + permalink + ')가 복사되었습니다.', '📋');
            } catch (err) {
              showToast('사이트 주소: ' + permalink + ' (Ctrl+D로 즐겨찾기에 추가하세요)', '📋');
            }
          });
        });

        document.querySelectorAll('.telegram-trigger').forEach((btn) => {
          btn.addEventListener('click', () => {
            window.open(telegramUrl, '_blank', 'noopener');
          });
        });
      });

      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    })();
  </script>
</body>
</html>
