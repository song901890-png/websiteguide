---
import BaseLayout from '../layouts/BaseLayout.astro';
import RetentionBar from '../components/RetentionBar.astro';
import HeroSearch from '../components/HeroSearch.astro';
import BookmarkDock from '../components/BookmarkDock.astro';
import DirectoryGrid from '../components/DirectoryGrid.astro';
import TrendsVerification from '../components/TrendsVerification.astro';
import EeatGuide from '../components/EeatGuide.astro';
import FaqSection from '../components/FaqSection.astro';
---
<BaseLayout includeHomeSchemas={true}>
  <RetentionBar />
  <HeroSearch />

  <!-- 로그인 없는 개인 북마크 (브라우저 localStorage) -->
  <BookmarkDock />

  <main>
    <!-- 12개 분야 디렉터리 -->
    <DirectoryGrid />

    <!-- 분야별 안전 접속 가이드 -->
    <TrendsVerification />

    <!-- 개념 비교 · 선정 기준 · 최신 칼럼 -->
    <EeatGuide />

  </main>

  <FaqSection />

  <script is:inline>
    (function () {
      const CHOSUNG_LIST = ['ㄱ','ㄲ','ㄴ','ㄷ','ㄸ','ㄹ','ㅁ','ㅂ','ㅃ','ㅅ','ㅆ','ㅇ','ㅈ','ㅉ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ'];
      const STORAGE_KEY = 'wg_bookmarks_v2';
      const DEFAULT_8_SITES = [
        '네이버 (NAVER)',
        '구글 코리아 (Google)',
        '유튜브 (YouTube)',
        '정부24 (Gov.kr)',
        '국세청 홈택스',
        '쿠팡 (Coupang)',
        '넷플릭스 (Netflix)',
        'ChatGPT (챗GPT)'
      ];
      let activeCategory = 'portal';
      let bookmarks = [...DEFAULT_8_SITES];

      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) bookmarks = JSON.parse(saved);
      } catch (e) {}

      function saveBookmarks() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
        } catch (e) {}
      }

      function extractChosung(str) {
        let result = '';
        for (let i = 0; i < str.length; i++) {
          const code = str.charCodeAt(i) - 44032;
          if (code >= 0 && code <= 11171) {
            result += CHOSUNG_LIST[Math.floor(code / 588)];
          } else {
            result += str.charAt(i);
          }
        }
        return result.toLowerCase();
      }

      function notify(msg, icon = '✅') {
        if (window.showJusoToast) window.showJusoToast(msg, icon);
      }

      function renderBookmarks() {
        const dock = document.getElementById('bookmark-dock-list');
        if (!dock) return;
        dock.innerHTML = '';
        if (bookmarks.length === 0) {
          dock.innerHTML = '<span class="text-xs text-slate-500">즐겨찾기가 비어 있습니다. 아래 카드에서 ☆ 아이콘을 클릭해 추가하세요.</span>';
        } else {
          bookmarks.forEach((name) => {
            const pill = document.createElement('span');
            pill.className = 'inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-full bg-white border border-indigo-200 text-indigo-950 text-xs font-bold shadow-2xs';
            const label = document.createElement('span');
            label.textContent = name;
            const rmBtn = document.createElement('button');
            rmBtn.type = 'button';
            rmBtn.className = 'text-indigo-400 hover:text-red-600 font-bold ml-1';
            rmBtn.setAttribute('aria-label', `${name} 북마크 삭제`);
            rmBtn.textContent = '✕';
            rmBtn.addEventListener('click', () => toggleBookmark(name));
            pill.appendChild(label);
            pill.appendChild(rmBtn);
            dock.appendChild(pill);
          });
        }

        document.querySelectorAll('.bookmark-star-btn').forEach((btn) => {
          const siteName = btn.getAttribute('data-bookmark-toggle');
          btn.textContent = siteName && bookmarks.includes(siteName) ? '⭐' : '☆';
        });
      }

      function toggleBookmark(name) {
        if (bookmarks.includes(name)) {
          bookmarks = bookmarks.filter((b) => b !== name);
          notify(`'${name}' 북마크가 해제되었습니다.`, '🗑️');
        } else {
          bookmarks.push(name);
          notify(`'${name}' 사이트를 내 북마크에 추가했습니다.`, '⭐');
        }
        saveBookmarks();
        renderBookmarks();
      }

      // ---- 디렉터리: 분야 탭 + 360곳 검색 ----
      let siteIndex = [];
      let categorySlugs = {};
      try {
        const raw = document.getElementById('site-search-index');
        if (raw) {
          const parsed = JSON.parse(raw.textContent || '{}');
          siteIndex = parsed.sites || [];
          categorySlugs = parsed.slugs || {};
        }
      } catch (e) {}

      const SEARCH_PAGE = 12;
      let searchMatches = [];
      let searchShown = 0;

      function escapeHtml(v) {
        return String(v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      }

      function resultCard(site) {
        const starred = bookmarks.includes(site.n);
        const slug = categorySlugs[site.c] || '';
        return '<article class="bg-white rounded-2xl border border-slate-200/90 p-4 shadow-2xs hover:shadow-md hover:border-indigo-300 transition-all flex flex-col justify-between gap-3">' +
          '<div><div class="flex items-start justify-between gap-2"><div class="min-w-0">' +
          '<h3 class="text-sm sm:text-base font-extrabold text-slate-900 truncate"><a href="' + escapeHtml(site.u) + '" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600">' + escapeHtml(site.n) + '</a></h3>' +
          '<p class="text-[11px] text-slate-400 font-medium mt-0.5 truncate"><a href="/category/' + escapeHtml(slug) + '/" class="text-indigo-600 font-bold hover:underline">' + escapeHtml(site.l) + '</a> · ' + escapeHtml(site.o) + '</p>' +
          '</div><button type="button" data-bookmark-toggle="' + escapeHtml(site.n) + '" aria-label="' + escapeHtml(site.n) + ' 즐겨찾기 추가/해제" class="bookmark-star-btn text-lg leading-none p-1 rounded hover:bg-slate-100 shrink-0">' + (starred ? '⭐' : '☆') + '</button></div>' +
          '<p class="mt-2 text-xs text-slate-600 leading-relaxed line-clamp-2">' + escapeHtml(site.x) + '</p></div>' +
          '<div class="flex items-center justify-between gap-2 text-xs"><span class="font-mono text-[11px] font-bold text-emerald-700 truncate">' + escapeHtml(site.d) + '</span>' +
          '<a href="' + escapeHtml(site.u) + '" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-2.5 py-1 rounded-lg bg-indigo-50 hover:bg-indigo-600 text-indigo-700 hover:text-white font-bold shrink-0">공식 사이트 ↗</a></div>' +
          '</article>';
      }

      function renderMoreResults() {
        const list = document.getElementById('search-result-list');
        const moreBtn = document.getElementById('btn-search-more');
        if (!list) return;
        const next = searchMatches.slice(searchShown, searchShown + SEARCH_PAGE);
        list.insertAdjacentHTML('beforeend', next.map(resultCard).join(''));
        searchShown += next.length;
        if (moreBtn) moreBtn.classList.toggle('hidden', searchShown >= searchMatches.length);
      }

      function filterDirectory() {
        const input = document.getElementById('chosung-search-input');
        const clearBtn = document.getElementById('btn-clear-search');
        const rawQuery = (input ? input.value : '').trim();
        const query = rawQuery.toLowerCase();
        const queryChosung = extractChosung(query);
        if (clearBtn) clearBtn.classList.toggle('hidden', query.length === 0);

        const panels = document.getElementById('directory-panels');
        const results = document.getElementById('directory-search-results');
        const list = document.getElementById('search-result-list');
        const summary = document.getElementById('search-result-summary');

        if (!query) {
          if (panels) panels.classList.remove('hidden');
          if (results) results.classList.add('hidden');
          return;
        }

        searchMatches = siteIndex.filter((site) => {
          const name = site.n.toLowerCase();
          return (
            name.includes(query) ||
            site.d.toLowerCase().includes(query) ||
            site.t.toLowerCase().includes(query) ||
            site.l.toLowerCase().includes(query) ||
            site.s.includes(query) ||
            extractChosung(name).includes(queryChosung)
          );
        });
        searchShown = 0;
        if (list) list.innerHTML = '';
        if (panels) panels.classList.add('hidden');
        if (results) results.classList.remove('hidden');
        if (summary) {
          summary.textContent = searchMatches.length > 0
            ? '‘' + rawQuery + '’ 검색 결과 ' + searchMatches.length + '곳 (전체 ' + siteIndex.length + '곳 중)'
            : '‘' + rawQuery + '’에 맞는 사이트가 없습니다. 다른 이름이나 초성으로 검색해 보세요.';
        }
        renderMoreResults();
      }

      function selectCategory(catId) {
        activeCategory = catId;
        document.querySelectorAll('.cat-filter-btn').forEach((b) => {
          const on = b.getAttribute('data-category') === catId;
          b.setAttribute('aria-selected', on ? 'true' : 'false');
          b.className = 'cat-filter-btn px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-all flex items-center space-x-1.5 border ' +
            (on ? 'bg-slate-900 text-white border-slate-900 shadow-sm' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-100');
        });
        document.querySelectorAll('.directory-panel').forEach((panel) => {
          panel.classList.toggle('hidden', panel.getAttribute('data-panel') !== catId);
        });
        const input = document.getElementById('chosung-search-input');
        if (input && input.value) {
          input.value = '';
          filterDirectory();
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        renderBookmarks();

        // ?q= 파라미터로 들어오면 바로 검색
        try {
          const params = new URLSearchParams(window.location.search);
          const qParam = params.get('q');
          const searchInput = document.getElementById('chosung-search-input');
          if (qParam && searchInput) {
            searchInput.value = qParam;
            filterDirectory();
          }
        } catch (e) {}

        const resetBtn = document.getElementById('btn-reset-bookmarks');
        if (resetBtn) {
          resetBtn.addEventListener('click', () => {
            bookmarks = [...DEFAULT_8_SITES];
            saveBookmarks();
            renderBookmarks();
            notify('기본 북마크 8곳을 복원했습니다.', '⭐');
          });
        }

        const searchInput = document.getElementById('chosung-search-input');
        if (searchInput) searchInput.addEventListener('input', filterDirectory);

        const triggerSearchBtn = document.getElementById('btn-trigger-search');
        if (triggerSearchBtn) {
          triggerSearchBtn.addEventListener('click', () => {
            filterDirectory();
            const dirSection = document.getElementById('section-directory');
            if (dirSection) dirSection.scrollIntoView({ behavior: 'smooth' });
          });
        }

        const clearBtn = document.getElementById('btn-clear-search');
        if (clearBtn && searchInput) {
          clearBtn.addEventListener('click', () => {
            searchInput.value = '';
            filterDirectory();
            searchInput.focus();
          });
        }

        document.querySelectorAll('.quick-query-pill').forEach((pill) => {
          pill.addEventListener('click', () => {
            const q = pill.getAttribute('data-quick-query') || '';
            if (searchInput) {
              searchInput.value = q;
              filterDirectory();
            }
          });
        });

        document.querySelectorAll('.cat-filter-btn').forEach((btn) => {
          btn.addEventListener('click', () => selectCategory(btn.getAttribute('data-category') || ''));
        });

        const moreBtn = document.getElementById('btn-search-more');
        if (moreBtn) moreBtn.addEventListener('click', renderMoreResults);

        // 별표 버튼: 검색 결과처럼 나중에 그려지는 카드도 처리하도록 이벤트 위임
        document.addEventListener('click', (e) => {
          const btn = e.target && e.target.closest ? e.target.closest('.bookmark-star-btn') : null;
          if (!btn) return;
          const name = btn.getAttribute('data-bookmark-toggle');
          if (name) toggleBookmark(name);
        });

        // FAQ Accordion Toggle
        document.querySelectorAll('.faq-toggle-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const panelId = btn.getAttribute('data-faq-btn');
            const panel = panelId ? document.getElementById(panelId) : null;
            const arrow = btn.querySelector('.faq-arrow');
            if (!panel) return;
            const isHidden = panel.classList.contains('hidden');
            panel.classList.toggle('hidden', !isHidden);
            btn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
            if (arrow) arrow.textContent = isHidden ? '▲' : '▼';
          });
        });
      });
    })();
  </script>
</BaseLayout>
