---
// 상단 고정 바: 사이트명 · 수록 현황 · 앱 설치/텔레그램/주소 복사
import { SITES_DATA } from '../data/sitesData';
import { DIRECTORY_UPDATED } from '../data/siteConfig';
---
<aside aria-label="사이트 정보 및 바로가기 바" class="bg-slate-950 text-slate-200 border-b border-slate-800 sticky top-0 z-40 shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-12 flex items-center justify-between gap-2 text-xs">
    <div class="flex items-center space-x-2 sm:space-x-3 overflow-hidden text-[11px] sm:text-xs">
      <a href="/" class="font-extrabold text-white shrink-0 hover:text-indigo-300 transition-colors">웹사이트가이드</a>
      <span class="text-slate-600">|</span>
      <span class="truncate">수록 <strong class="text-white font-bold">{SITES_DATA.length}곳</strong> (12개 분야)</span>
      <span class="hidden lg:inline text-slate-600">|</span>
      <span class="hidden lg:inline text-slate-400">최종 업데이트: <time datetime={DIRECTORY_UPDATED}>{DIRECTORY_UPDATED.replaceAll('-', '.')}</time></span>
    </div>

    <!-- 바로가기 버튼 -->
    <div class="flex items-center space-x-1.5 sm:space-x-2 shrink-0">
      <button type="button" data-action="pwa-install" class="pwa-install-trigger inline-flex items-center space-x-1 px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-indigo-600 text-slate-200 hover:text-white font-semibold transition-colors">
        <span>📱</span>
        <span class="hidden md:inline">앱으로 바탕화면 설치</span>
        <span class="md:hidden">앱설치</span>
      </button>
      <button type="button" data-action="telegram-channel" class="telegram-trigger inline-flex items-center space-x-1 px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-sky-600 text-slate-200 hover:text-white font-semibold transition-colors">
        <span>✈️</span>
        <span class="hidden md:inline">텔레그램 소식 채널</span>
      </button>
      <button type="button" data-action="copy-permalink" class="permalink-trigger inline-flex items-center space-x-1 px-2.5 py-1 rounded-lg bg-indigo-600/30 border border-indigo-400/40 hover:bg-indigo-600 text-indigo-200 hover:text-white font-bold transition-colors">
        <span>📋</span>
        <span>사이트 주소 복사</span>
      </button>
    </div>
  </div>
</aside>

<!-- 모바일 하단 고정 바 -->
<div aria-label="모바일 하단 고정 리텐션 바" class="sm:hidden fixed bottom-0 inset-x-0 z-40 bg-slate-950/95 backdrop-blur border-t border-slate-800 px-3 py-2 flex items-center justify-around text-[11px] font-bold text-slate-200 shadow-2xl">
  <button type="button" class="pwa-install-trigger flex items-center space-x-1 px-2.5 py-1.5 rounded-lg bg-slate-800 text-emerald-300">
    <span>📱</span><span>바탕화면 설치</span>
  </button>
  <button type="button" class="telegram-trigger flex items-center space-x-1 px-2.5 py-1.5 rounded-lg bg-slate-800 text-sky-300">
    <span>✈️</span><span>텔레그램 알림</span>
  </button>
  <button type="button" class="permalink-trigger flex items-center space-x-1 px-2.5 py-1.5 rounded-lg bg-indigo-600 text-white">
    <span>📋</span><span>주소 복사</span>
  </button>
</div>
