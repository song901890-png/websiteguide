---
// 분야별 안전 접속 가이드 + 대표 사이트 공식 주소 확인표
import { SAFE_ACCESS_GUIDE, OFFICIAL_DOMAIN_CHECKS } from '../data/sitesData';

interface Props {
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---
<section id="section-verification" aria-labelledby="heading-verification" class="py-12 bg-slate-100/90 border-y border-slate-200 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto space-y-10">
    <div class="space-y-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Safe Access Guide</span>
        <Heading id="heading-verification" class="text-xl sm:text-2xl font-extrabold text-slate-900 mt-1">
          자주 찾는 주제별 안전 접속 가이드
        </Heading>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          사칭·피싱 사이트가 자주 노리는 주제와 공식 접속처를 정리했습니다. 검색 결과나 문자 링크 대신 아래 공식 서비스로 접속하세요.
        </p>
      </div>

      <div class="overflow-x-auto bg-white rounded-2xl border border-slate-200 shadow-2xs">
        <table class="w-full text-left border-collapse text-xs">
          <caption class="sr-only">주제별 공식 접속처와 주의할 사칭 유형</caption>
          <thead>
            <tr class="bg-slate-900 text-white">
              <th scope="col" class="py-3 px-4 font-bold">주제</th>
              <th scope="col" class="py-3 px-4 font-bold">분야</th>
              <th scope="col" class="py-3 px-4 font-bold">공식 접속처</th>
              <th scope="col" class="py-3 px-4 font-bold">주의할 사칭 유형</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            {SAFE_ACCESS_GUIDE.map((item) => (
              <tr class="hover:bg-slate-50">
                <th scope="row" class="py-3 px-4 font-bold text-slate-900">{item.topic}</th>
                <td class="py-3 px-4">
                  <a href={`/category/${item.categorySlug}/`} class="text-indigo-700 font-semibold hover:underline">{item.category}</a>
                </td>
                <td class="py-3 px-4 font-semibold text-slate-800">{item.safeDest}</td>
                <td class="py-3 px-4 text-slate-600">{item.warning}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="space-y-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-700">Official Domains</span>
        <h3 class="text-lg sm:text-xl font-extrabold text-slate-900 mt-1">
          분야별 대표 사이트 공식 주소 확인표
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          8개 분야 대표 서비스의 공식 주소와, 사칭 사이트를 피하기 위해 확인할 점입니다.
        </p>
      </div>

      <div class="overflow-x-auto bg-white rounded-2xl border border-slate-200 shadow-2xs">
        <table class="w-full text-left border-collapse text-xs">
          <caption class="sr-only">분야별 대표 서비스의 공식 주소와 확인 포인트</caption>
          <thead>
            <tr class="bg-slate-100 text-slate-800 border-b border-slate-200">
              <th scope="col" class="py-3 px-4 font-bold">분야</th>
              <th scope="col" class="py-3 px-4 font-bold">서비스</th>
              <th scope="col" class="py-3 px-4 font-bold">공식 주소</th>
              <th scope="col" class="py-3 px-4 font-bold">확인 포인트</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            {OFFICIAL_DOMAIN_CHECKS.map((row) => (
              <tr class="hover:bg-slate-50">
                <td class="py-3 px-4 font-bold text-slate-900">{row.sector}</td>
                <th scope="row" class="py-3 px-4 font-semibold text-indigo-700">{row.service}</th>
                <td class="py-3 px-4 font-mono text-slate-800">
                  <a href={row.officialUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">{row.officialUrl}</a>
                </td>
                <td class="py-3 px-4 text-slate-600">{row.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
