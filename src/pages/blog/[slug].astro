---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RetentionBar from '../../components/RetentionBar.astro';
import FaqSection from '../../components/FaqSection.astro';
import { INITIAL_BLOG_POSTS, normalizeInternalLink } from '../../data/blogPosts';

export function getStaticPaths() {
  return INITIAL_BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const pageTitle = `${post.title} | 웹사이트가이드`;
const canonicalURL = `https://www.websiteguide.io/blog/${post.slug}/`;
const relatedPosts = INITIAL_BLOG_POSTS.filter((p) => p.slug !== post.slug);

const topLink = normalizeInternalLink(
  post.internalLinkTop,
  '웹사이트가이드 분야별 공식 사이트 디렉터리',
  '/'
);
const bottomLink = normalizeInternalLink(
  post.internalLinkBottom,
  `${post.targetCategoryName} 디렉터리`,
  `/category/${post.targetCategorySlug}/`
);
const resolvedBottomHref =
  bottomLink.url === '#section-directory'
    ? `/category/${post.targetCategorySlug}/`
    : bottomLink.url;

const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "웹사이트가이드 홈",
          "item": "https://www.websiteguide.io/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "디지털 안전 가이드 블로그",
          "item": "https://www.websiteguide.io/blog/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": post.title,
          "item": canonicalURL
        }
      ]
    },
    {
      "@type": "BlogPosting",
      "@id": `${canonicalURL}#article`,
      "headline": post.title,
      "description": post.summary,
      "image": "https://www.websiteguide.io/og-image.png",
      "datePublished": post.date,
      "dateModified": post.updatedDate || post.date,
      "articleSection": post.category,
      "inLanguage": "ko-KR",
      "wordCount": post.charCount,
      "author": {
        "@type": "Organization",
        "name": "웹사이트가이드 편집팀",
        "url": "https://www.websiteguide.io/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "웹사이트가이드 (WebsiteGuide)",
        "url": "https://www.websiteguide.io/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://www.websiteguide.io/icon-512.png"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalURL
      },
      "keywords": post.seoKeywords.join(', ')
    }
  ]
};
---
<BaseLayout
  title={pageTitle}
  description={post.summary}
  canonicalURL={canonicalURL}
  ogType="article"
  publishedTime={post.date}
  modifiedTime={post.updatedDate || post.date}
  articleSection={post.category}
  keywords={post.seoKeywords}
  jsonLd={articleSchema}
>
  <RetentionBar />

  <main class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8 space-y-8">
    <nav aria-label="브레드크럼 내비게이션" class="text-xs text-slate-500 flex flex-wrap items-center gap-2">
      <a href="/" class="hover:text-indigo-600 font-bold">🏠 웹사이트가이드 홈</a>
      <span>/</span>
      <a href="/blog/" class="hover:text-indigo-600 font-semibold">디지털 안전 칼럼 (BLOG)</a>
      <span>/</span>
      <span class="text-slate-800 font-bold truncate">{post.category}</span>
    </nav>

    <article class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-sm space-y-8">
      <header class="border-b border-slate-200 pb-6 space-y-3">
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <span class="px-2.5 py-1 bg-indigo-50 text-indigo-700 font-extrabold rounded-md">{post.category}</span>
          <span class="text-slate-400">|</span>
          <time datetime={post.date} class="font-mono text-slate-500 font-semibold">발행일: {post.date}</time>
          <span class="text-slate-400">|</span>
          <span class="text-emerald-700 font-bold">📖 {post.readingTime} (약 {post.charCount.toLocaleString()}자)</span>
        </div>
        <h1 class="text-xl sm:text-3xl font-extrabold text-slate-900 leading-tight">
          {post.title}
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          {post.summary}
        </p>
      </header>

      <div class="p-4 sm:p-5 rounded-2xl bg-indigo-50/70 border border-indigo-200 text-xs sm:text-sm text-slate-700 leading-relaxed">
        <p>
          💡 <strong>핵심 안전 요약:</strong> {topLink.text}{' '}
          <a href={topLink.url} class="text-indigo-700 font-extrabold underline hover:text-indigo-900">
            [{topLink.anchor}]
          </a>를 북마크해 두고 이용하시는 것이 가장 안전합니다.
        </p>
      </div>

      <nav aria-label="칼럼 목차" class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 text-xs space-y-2">
        <div class="font-extrabold text-slate-900">📑 칼럼 핵심 목차</div>
        <ol class="space-y-1 text-slate-600">
          {post.sections.map((sec, idx) => (
            <li>
              <a href={`#section-${idx + 1}`} class="hover:text-indigo-600 hover:underline font-medium">
                {sec.heading}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="space-y-8 text-sm sm:text-base text-slate-700 leading-relaxed">
        {post.sections.map((sec, idx) => (
          <section id={`section-${idx + 1}`} class="space-y-3 scroll-mt-20">
            <h2 class="text-base sm:text-xl font-extrabold text-slate-900 border-l-4 border-indigo-600 pl-3">
              {sec.heading}
            </h2>
            {sec.paragraphs.map((p) => (
              <p class="text-xs sm:text-sm text-slate-700 leading-7">{p}</p>
            ))}
          </section>
        ))}
      </div>

      <div class="pt-4 border-t border-slate-100 flex flex-wrap gap-1.5">
        {post.seoKeywords.map((kw) => (
          <span class="text-[11px] px-2.5 py-1 bg-slate-100 text-slate-600 rounded-full font-medium">
            #{kw}
          </span>
        ))}
      </div>

      <footer class="p-5 sm:p-6 rounded-2xl bg-slate-900 text-slate-200 space-y-3">
        <div class="text-xs font-bold text-emerald-400 uppercase tracking-wider">
          관련 디렉터리
        </div>
        <p class="text-xs sm:text-sm leading-relaxed">
          {bottomLink.text}{' '}
          <a href={resolvedBottomHref} class="text-amber-300 font-extrabold underline hover:text-white">
            [{bottomLink.anchor}]
          </a>에서 확인할 수 있습니다.
        </p>
        <div class="pt-2 flex flex-wrap gap-2">
          <a href={resolvedBottomHref} class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs transition-colors">
            📂 {post.targetCategoryName} 바로가기 →
          </a>
          <a href="/blog/" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs transition-colors">
            📚 블로그 칼럼 전체 목록
          </a>
          <a href="/" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs transition-colors">
            🏠 웹사이트가이드 홈
          </a>
        </div>
      </footer>
    </article>

    <section aria-label="관련 디지털 안전 가이드 칼럼" class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-2xs space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-base sm:text-lg font-extrabold text-slate-900">
          📖 함께 읽으면 좋은 디지털 안전 가이드 칼럼
        </h2>
        <a href="/blog/" class="text-xs font-bold text-indigo-600 hover:underline">전체 칼럼 보기 →</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {relatedPosts.map((rel) => (
          <a
            href={`/blog/${rel.slug}/`}
            class="group p-4 rounded-2xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/30 transition-all space-y-1.5"
          >
            <div class="flex items-center justify-between text-[11px] text-slate-400 font-semibold">
              <span class="text-indigo-600 font-bold">{rel.category}</span>
              <span>{rel.date}</span>
            </div>
            <h3 class="text-xs sm:text-sm font-extrabold text-slate-900 group-hover:text-indigo-700 leading-snug">
              {rel.title}
            </h3>
            <p class="text-[11px] text-slate-500 line-clamp-2 leading-relaxed">
              {rel.summary}
            </p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <FaqSection hideFaq={true} />
</BaseLayout>
