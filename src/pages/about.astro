---
import BaseLayout from '../layouts/BaseLayout.astro';
import RetentionBar from '../components/RetentionBar.astro';
import FaqSection from '../components/FaqSection.astro';
import { CATEGORIES, SITES_DATA } from '../data/sitesData';
import { SITE_URL, SITE_NAME, SITE_NAME_FULL, EDITOR_NAME, CONTACT_EMAIL, TELEGRAM_URL, TELEGRAM_HANDLE, DIRECTORY_UPDATED } from '../data/siteConfig';

const pageTitle = `${SITE_NAME} 소개 — 운영 목적과 편집 원칙 | ${SITE_NAME}`;
const pageDesc = `${SITE_NAME}는 12개 분야 ${SITES_DATA.length}곳 공식 웹사이트의 주소와 이용 조건을 정리해, 사칭 사이트 대신 공식 사이트로 안전하게 이동하도록 돕는 웹사이트 안내 가이드입니다.`;
const canonicalURL = `${SITE_URL}/about/`;
const categories = CATEGORIES.filter((c) => c.id !== 'all');

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': `${SITE_NAME} 홈`, 'item': `${SITE_URL}/` },
        { '@type': 'ListItem', 'position': 2, 'name': `${SITE_NAME} 소개`, 'item': canonicalURL }
      ]
    },
    {
      '@type': 'AboutPage',
      '@id': `${canonicalURL}#webpage`,
      'url': canonicalURL,
      'name': pageTitle,
      'description': pageDesc,
      'inLanguage': 'ko-KR',
      'dateModified': DIRECTORY_UPDATED,
      'about': { '@id': `${SITE_URL}/#organization` },
      'isPartOf': { '@id': `${SITE_URL}/#website` }
    }
  ]
};
---
<BaseLayout title={pageTitle} description={pageDesc} canonicalURL={canonicalURL} jsonLd={pageSchema}>
  <RetentionBar />
  <main class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8 space-y-8">
    <nav aria-label="브레드크럼 내비게이션" class="text-xs text-slate-500 flex items-center space-x-2">
      <a href="/" class="hover:text-indigo-600 font-bold">🏠 {SITE_NAME} 홈</a>
      <span>/</span>
      <span class="text-slate-900 font-extrabold">소개</span>
    </nav>

    <article class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-sm space-y-10">
      <header class="border-b border-slate-200 pb-6 space-y-3">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">About · {SITE_NAME_FULL}</span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">{SITE_NAME}를 소개합니다</h1>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{pageDesc}</p>
      </header>

      <section aria-labelledby="h-why" class="space-y-3">
        <h2 id="h-why" class="text-base sm:text-xl font-extrabold text-slate-900 border-l-4 border-indigo-600 pl-3">왜 만들었나요</h2>
        <p class="text-xs sm:text-sm text-slate-700 leading-7">
          검색 광고, 문자, 메신저로 전달되는 링크 중에는 유명 서비스를 흉내 낸 사칭 사이트가 적지 않습니다. {SITE_NAME}는 자주 쓰는 웹사이트의 공식 주소를 한곳에 모아, 링크를 의심할 필요 없이 바로 이동할 수 있도록 만든 안내 사이트입니다.
        </p>
        <p class="text-xs sm:text-sm text-slate-700 leading-7">
          주소만 나열하지 않고 운영 주체, 비용, 가입·본인인증 조건, 비슷한 대안 서비스를 함께 적어 목적에 맞는 서비스를 고를 수 있게 했습니다.
        </p>
      </section>

      <section aria-labelledby="h-what" class="space-y-3">
        <h2 id="h-what" class="text-base sm:text-xl font-extrabold text-slate-900 border-l-4 border-indigo-600 pl-3">무엇을 제공하나요</h2>
        <ul class="space-y-2 text-xs sm:text-sm text-slate-700 leading-7">
          <li>• <strong>분야별 디렉터리:</strong> 12개 분야 각 30곳, 총 {SITES_DATA.length}곳의 공식 웹사이트</li>
          <li>• <strong>초성 검색과 개인 북마크:</strong> 로그인 없이 브라우저에만 저장되는 즐겨찾기</li>
          <li>• <strong><a href="/address-verification/" class="text-indigo-700 underline">안전 접속 가이드</a>:</strong> 사칭이 잦은 주제별 공식 접속처</li>
          <li>• <strong><a href="/blog/" class="text-indigo-700 underline">디지털 안전 칼럼</a></strong>과 <strong><a href="/internet-of-things/" class="text-indigo-700 underline">사물인터넷(IoT) 기술 가이드</a></strong></li>
        </ul>
        <div class="flex flex-wrap gap-1.5 pt-2">
          {categories.map((cat) => (
            <a href={`/category/${cat.slug}/`} class="px-3 py-1.5 rounded-xl bg-slate-50 hover:bg-indigo-50 border border-slate-200 text-xs font-bold text-slate-700">{cat.icon} {cat.name}</a>
          ))}
        </div>
      </section>

      <section aria-labelledby="h-who" class="space-y-3">
        <h2 id="h-who" class="text-base sm:text-xl font-extrabold text-slate-900 border-l-4 border-indigo-600 pl-3">누가 운영하나요</h2>
        <p class="text-xs sm:text-sm text-slate-700 leading-7">
          {SITE_NAME}는 {EDITOR_NAME}이 운영합니다. 편집팀은 <a href="/selection-criteria/" class="text-indigo-700 font-bold underline">공개된 선정 기준</a>에 따라 사이트를 등재하고, 정기 점검과 이용자 제보로 정보를 고칩니다. 금전이나 대가를 받고 사이트를 등재하지 않습니다.
        </p>
        <p class="text-xs sm:text-sm text-slate-700 leading-7">
          {SITE_NAME}는 각 서비스와 제휴 관계가 없는 독립 안내 사이트이며, 소개한 서비스의 상표와 이름은 각 운영사에 있습니다.
        </p>
      </section>

      <section aria-labelledby="h-contact" class="space-y-3">
        <h2 id="h-contact" class="text-base sm:text-xl font-extrabold text-slate-900 border-l-4 border-indigo-600 pl-3">연락처</h2>
        <ul class="text-xs sm:text-sm text-slate-700 leading-7">
          <li>• 이메일: <a href={`mailto:${CONTACT_EMAIL}`} class="text-indigo-700 font-bold underline">{CONTACT_EMAIL}</a></li>
          <li>• 텔레그램: <a href={TELEGRAM_URL} target="_blank" rel="noopener" class="text-indigo-700 font-bold underline">{TELEGRAM_HANDLE}</a></li>
          <li>• 정정 요청 방법은 <a href="/contact/" class="text-indigo-700 font-bold underline">문의 페이지</a>를 참고하세요.</li>
        </ul>
      </section>
    </article>
  </main>
  <FaqSection hideFaq={true} />
</BaseLayout>
