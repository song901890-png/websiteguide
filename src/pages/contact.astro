---
import BaseLayout from '../layouts/BaseLayout.astro';
import RetentionBar from '../components/RetentionBar.astro';
import FaqSection from '../components/FaqSection.astro';
import { SITE_URL, SITE_NAME, EDITOR_NAME, CONTACT_EMAIL, TELEGRAM_URL, TELEGRAM_HANDLE } from '../data/siteConfig';

const pageTitle = `문의 및 정정 요청 | ${SITE_NAME}`;
const pageDesc = `${SITE_NAME}에 등록된 사이트 정보의 오류 제보, 새 공식 사이트 등재 요청, 일반 문의 방법을 안내합니다.`;
const canonicalURL = `${SITE_URL}/contact/`;

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': `${SITE_NAME} 홈`, 'item': `${SITE_URL}/` },
        { '@type': 'ListItem', 'position': 2, 'name': '문의 및 정정 요청', 'item': canonicalURL }
      ]
    },
    {
      '@type': 'ContactPage',
      '@id': `${canonicalURL}#webpage`,
      'url': canonicalURL,
      'name': pageTitle,
      'description': pageDesc,
      'inLanguage': 'ko-KR',
      'about': { '@id': `${SITE_URL}/#organization` },
      'isPartOf': { '@id': `${SITE_URL}/#website` }
    }
  ]
};
const mailSubject = encodeURIComponent('[웹사이트가이드] 정정 요청');
---
<BaseLayout title={pageTitle} description={pageDesc} canonicalURL={canonicalURL} jsonLd={pageSchema}>
  <RetentionBar />
  <main class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8 space-y-8">
    <nav aria-label="브레드크럼 내비게이션" class="text-xs text-slate-500 flex items-center space-x-2">
      <a href="/" class="hover:text-indigo-600 font-bold">🏠 {SITE_NAME} 홈</a>
      <span>/</span>
      <span class="text-slate-900 font-extrabold">문의 및 정정 요청</span>
    </nav>

    <article class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-sm space-y-8">
      <header class="border-b border-slate-200 pb-6 space-y-3">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Contact</span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">문의 및 정정 요청</h1>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{pageDesc}</p>
      </header>

      <section aria-labelledby="h-channels" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <h2 id="h-channels" class="sr-only">연락 방법</h2>
        <a href={`mailto:${CONTACT_EMAIL}?subject=${mailSubject}`} class="block p-5 rounded-2xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/30 transition-all">
          <div class="text-xs font-bold text-slate-500">이메일</div>
          <div class="mt-1 text-base font-extrabold text-slate-900">{CONTACT_EMAIL}</div>
          <p class="mt-1 text-xs text-slate-600">정정 요청과 등재 요청은 이메일로 보내 주시면 기록이 남아 처리가 빠릅니다.</p>
        </a>
        <a href={TELEGRAM_URL} target="_blank" rel="noopener" class="block p-5 rounded-2xl border border-slate-200 hover:border-sky-300 hover:bg-sky-50/40 transition-all">
          <div class="text-xs font-bold text-slate-500">텔레그램</div>
          <div class="mt-1 text-base font-extrabold text-slate-900">{TELEGRAM_HANDLE}</div>
          <p class="mt-1 text-xs text-slate-600">간단한 문의나 사이트 소식 확인에 이용하세요.</p>
        </a>
      </section>

      <section aria-labelledby="h-how" class="space-y-3">
        <h2 id="h-how" class="text-base sm:text-xl font-extrabold text-slate-900 border-l-4 border-indigo-600 pl-3">정정 요청 시 함께 보내 주세요</h2>
        <ol class="space-y-1.5 text-xs sm:text-sm text-slate-700 leading-7 list-decimal list-inside">
          <li>해당 페이지 주소 (예: /category/finance/)</li>
          <li>사이트 이름과 잘못된 내용</li>
          <li>올바른 내용과 이를 확인할 수 있는 공식 출처 (운영사 공지, 공식 홈페이지 등)</li>
        </ol>
        <p class="text-xs sm:text-sm text-slate-700 leading-7">
          {EDITOR_NAME}은 공식 출처를 확인한 뒤 반영하며, 확인할 수 없는 내용은 반영하지 않습니다. 등재 기준은 <a href="/selection-criteria/" class="text-indigo-700 font-bold underline">사이트 선정 기준</a>에서 확인할 수 있습니다.
        </p>
      </section>

      <section aria-labelledby="h-not" class="space-y-3">
        <h2 id="h-not" class="text-base sm:text-xl font-extrabold text-slate-900 border-l-4 border-indigo-600 pl-3">받지 않는 요청</h2>
        <ul class="space-y-1.5 text-xs sm:text-sm text-slate-700 leading-7">
          <li>• 금전이나 대가를 조건으로 한 등재·순서 변경 요청</li>
          <li>• 불법 스트리밍, 도박, 성인, 접속 차단 우회 사이트의 등재 요청</li>
          <li>• 개별 서비스의 계정·결제 문제 (해당 서비스 고객센터로 문의해 주세요)</li>
        </ul>
      </section>
    </article>
  </main>
  <FaqSection hideFaq={true} />
</BaseLayout>
