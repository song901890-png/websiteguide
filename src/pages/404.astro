---
import BaseLayout from '../layouts/BaseLayout.astro';
import RetentionBar from '../components/RetentionBar.astro';
import FaqSection from '../components/FaqSection.astro';
import { CATEGORIES } from '../data/sitesData';

const pageTitle = '페이지를 찾을 수 없습니다 (404) | 웹사이트가이드';
const pageDesc = '요청하신 페이지의 주소가 변경되었거나 삭제되었습니다. 웹사이트가이드 홈이나 분야별 디렉터리에서 원하는 사이트를 찾아보세요.';
---
<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalURL="https://www.websiteguide.io/404"
  noindex={true}
>
  <RetentionBar />
  <main class="max-w-4xl mx-auto py-16 px-4 sm:px-6 lg:px-8 text-center space-y-8">
    <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm space-y-5">
      <div class="inline-flex items-center px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-extrabold">
        404 Not Found
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900">
        찾으시는 페이지 주소가 변경되었거나 존재하지 않습니다
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">
        입력한 주소의 철자를 다시 확인하거나, 아래 분야별 디렉터리와 블로그에서 원하는 페이지를 찾아보세요.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a href="/" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs sm:text-sm transition-colors">
          🏠 웹사이트가이드 홈으로
        </a>
        <a href="/blog/" class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs sm:text-sm transition-colors">
          📚 디지털 안전 칼럼 블로그
        </a>
      </div>

      <div class="pt-6 border-t border-slate-100 text-left space-y-3">
        <h2 class="text-xs font-extrabold text-slate-700 text-center">📂 분야별 디렉터리 바로가기</h2>
        <div class="flex flex-wrap items-center justify-center gap-2">
          {CATEGORIES.filter((c) => c.id !== 'all').map((cat) => (
            <a
              href={`/category/${cat.slug}/`}
              class="px-3 py-1.5 rounded-xl bg-slate-50 hover:bg-indigo-50 text-slate-700 hover:text-indigo-700 border border-slate-200 text-xs font-bold transition-colors"
            >
              {cat.icon} {cat.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </main>
  <FaqSection hideFaq={true} />
</BaseLayout>
